{
  "name": "picopad-companion",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop and phone companion for the PicoDeck launcher",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "dev.msuii.picodeck",
    "productName": "PicoDeck Companion",
    "electronVersion": "44.9.3",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "web/**/*",
      "assets/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../themes",
        "to": "themes"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "PicoDeckCompanion-${version}-x86_64.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PicoDeckCompanion-${version}-x64.${ext}"
    },
    "npmRebuild": false
  }
}
